# FinOps Down-Scaler — environment configuration
# Copy this file to .env, then edit values for your environment.
# In demo mode (the default) none of these are required.
#
# Usage:
#   cp .env.example .env
#   docker compose up          # dashboard only, demo data
#   docker compose --profile full up   # dashboard + controller, real cluster

# ── Mode ────────────────────────────────────────────────────────────────────
DEMO_MODE=false            # true = synthetic data, no cluster needed
DRY_RUN=true               # true = log decisions only, no K8s mutations
DASHBOARD_PORT=8090        # host port for the dashboard UI

# ── Connection ───────────────────────────────────────────────────────────────
# Prometheus endpoint reachable from inside the container / pod
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090

# ── Cloud & Pricing ──────────────────────────────────────────────────────────
CLOUD_PROVIDER=manual      # aws | gcp | manual
NODE_INSTANCE_TYPE=        # e.g. m5.xlarge  (aws) or n2-standard-4  (gcp)
AWS_REGION=                # e.g. us-east-1  (required when CLOUD_PROVIDER=aws)
NODE_HOURLY_COST=0.192     # USD/hr fallback used when cloud API is unavailable

# ── Schedule ─────────────────────────────────────────────────────────────────
BUSINESS_HOURS_START=07:00      # HH:MM in TIMEZONE
BUSINESS_HOURS_END=19:00
BUSINESS_DAYS=0,1,2,3,4         # 0=Mon … 6=Sun
TIMEZONE=UTC                    # IANA name, e.g. America/New_York
PREWARM_MINUTES=15              # scale up this many minutes before window opens

# ── Scaling ──────────────────────────────────────────────────────────────────
MIN_REPLICA_FLOOR=0             # minimum replicas during off-hours (0 = zero)
NODE_UTILISATION_THRESHOLD=0.10 # CPU fraction below which a node is cordoned
NAMESPACE_FILTER=               # restrict to one namespace; empty = all
LOOP_INTERVAL_SECONDS=60        # controller poll cadence

# ── Prophet ML forecasting (optional) ────────────────────────────────────────
# Requires: pip install -r requirements-prophet.txt
# Prometheus must have ≥ PROPHET_TRAINING_WEEKS of metric history.
ENABLE_PROPHET=false
PROPHET_TRAINING_WEEKS=4
PROPHET_IDLE_THRESHOLD_CORES=0.5
PROPHET_RETRAIN_HOURS=6
